					"mode": "raw",
					"raw": "{\n  \"schema_version\": \"1.1\",\n  \"type_definitions\": [\n    {\n      \"type\": \"user\",\n      \"relations\": {},\n      \"metadata\": null\n    },\n    {\n      \"type\": \"resource\",\n      \"relations\": {\n        \"delete\": {\n          \"this\": {}\n        },\n        \"get\": {\n          \"this\": {}\n        },\n        \"patch\": {\n          \"this\": {}\n        },\n        \"post\": {\n          \"this\": {}\n        },\n        \"put\": {\n          \"this\": {}\n        }\n      },\n      \"metadata\": {\n        \"relations\": {\n          \"delete\": {\n            \"directly_related_user_types\": [\n              {\n                \"type\": \"user\"\n              },\n              {\n                \"type\": \"user\",\n                \"condition\": \"ttl\"\n              }\n            ]\n          },\n          \"get\": {\n            \"directly_related_user_types\": [\n              {\n                \"type\": \"user\"\n              },\n              {\n                \"type\": \"user\",\n                \"condition\": \"ttl\"\n              }\n            ]\n          },\n          \"patch\": {\n            \"directly_related_user_types\": [\n              {\n                \"type\": \"user\"\n              },\n              {\n                \"type\": \"user\",\n                \"condition\": \"ttl\"\n              }\n            ]\n          },\n          \"post\": {\n            \"directly_related_user_types\": [\n              {\n                \"type\": \"user\"\n              },\n              {\n                \"type\": \"user\",\n                \"condition\": \"ttl\"\n              }\n            ]\n          },\n          \"put\": {\n            \"directly_related_user_types\": [\n              {\n                \"type\": \"user\"\n              },\n              {\n                \"type\": \"user\",\n                \"condition\": \"ttl\"\n              }\n            ]\n          }\n        }\n      }\n    }\n  ],\n  \"conditions\": {\n    \"ttl\": {\n      \"name\": \"ttl\",\n      \"expression\": \"current <= expiry\",\n      \"parameters\": {\n        \"current\": {\n          \"type_name\": \"TYPE_NAME_UINT\"\n        },\n        \"expiry\": {\n          \"type_name\": \"TYPE_NAME_UINT\"\n        }\n      }\n    }\n  }\n}",
